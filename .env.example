# URL pubblico del sito (senza / finale)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contatti mostrati sul sito
NEXT_PUBLIC_WHATSAPP_NUMBER=   # es. 393331234567 (senza +)
NEXT_PUBLIC_PHONE=             # es. +39 333 123 4567
NEXT_PUBLIC_INSTAGRAM_URL=

# Tracciamento: caricati solo dopo il consenso cookie
NEXT_PUBLIC_GA_ID=             # es. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# Database Postgres (Supabase o Neon). In locale: copia questo file in .env
# DATABASE_URL = connessione con pooler (app), DATABASE_URL_UNPOOLED = diretta (migrazioni). `neon env pull` le scrive entrambe.
DATABASE_URL=postgresql://levelup:levelup@localhost:5432/levelup
DATABASE_URL_UNPOOLED=postgresql://levelup:levelup@localhost:5432/levelup

# Cellulare di Giulia in formato E.164: il seed lo crea come admin
ADMIN_PHONE=

# Firma dei cookie di sessione e degli hash OTP: stringa casuale lunga (es. openssl rand -hex 32)
SESSION_SECRET=

# Solo finché WhatsApp non è configurato: mostra il codice OTP a schermo (anteprime).
# Ignorato quando le chiavi WhatsApp sono presenti.
OTP_DEV_SHOW=0

# WhatsApp Business Cloud API (Meta). Vuoti = modalità prova (messaggi in console)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token scelto da te per verificare il webhook in Meta (fase 6)
WHATSAPP_VERIFY_TOKEN=
# Chiave segreta dell'app Meta, per verificare la firma dei webhook
WHATSAPP_APP_SECRET=
# Nomi dei template approvati (facoltativi, questi sono i default)
# WA_TPL_OTP=codice_accesso
# WA_TPL_CONFIRMATION=prenotazione_confermata
# WA_TPL_REMINDER=promemoria_appuntamento
# WA_TPL_WAITLIST=posto_libero
# WA_TPL_CANCELLATION=prenotazione_disdetta
# WA_TPL_RECALL=richiamo_cliente
# WA_TPL_REVIEW=richiesta_recensione

# Stripe (carta a garanzia). Vuoti = modalità prova, la carta non viene richiesta.
# In prova usa le chiavi "test" (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Protegge /api/cron/tick (Vercel Cron lo invia da solo come Authorization: Bearer)
CRON_SECRET=
# Link alla scheda Google per le recensioni (es. https://g.page/r/.../review)
GOOGLE_REVIEW_URL=
